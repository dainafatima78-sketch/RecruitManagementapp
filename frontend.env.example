# Frontend Client Environment Variables (.env)

# Backend REST API Base URL
# When deployed on Vercel, point this to your live Render backend URL:
# e.g., https://recruitai-backend.onrender.com
VITE_API_BASE_URL="https://your-backend.onrender.com"

# Local Development default (empty string proxies to local origin):
# VITE_API_BASE_URL=""

