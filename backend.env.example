# Backend Server Environment Variables (.env)

# Environment Mode (development | production)
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection URL
# For a PostgreSQL server on this Windows PC, use localhost and your existing
# database/user. URL-encode reserved characters in the password.
DATABASE_URL="postgresql://kisaschool:URL_ENCODED_PASSWORD@127.0.0.1:5432/recruitai_db"

# AgentRouter API Configuration (ChatGPT 6 Astra)
# Official portal: https://agentrouter.org
AGENTROUTER_API_KEY="YOUR_AGENTROUTER_API_KEY"
AGENTROUTER_BASE_URL="https://agentrouter.org"
AGENTROUTER_MODEL="gpt-6-astra"

# Frontend Web Application URL (Allowed CORS Origin)
# e.g., https://recruit-managementapp.vercel.app
FRONTEND_URL="https://your-frontend.vercel.app"
APP_URL="https://your-backend.onrender.com"

# Optional Gemini Fallback API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

